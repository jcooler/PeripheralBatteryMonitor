{
  "Name": "Peripheral Battery Monitor",
  "Version": "1.1.0.0",
  "Author": "jcooler",
  "Description": "Display battery status from passive SteelSeries GG events, Windows Bluetooth and gamepads, Logitech G Hub, and supported HID devices.",
  "Category": "Peripheral Battery Monitor",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "UUID": "com.jcooler.peripheral-battery",
  "Actions": [
    {
      "Name": "Battery Monitor",
      "UUID": "com.jcooler.peripheral-battery.monitor",
      "Icon": "imgs/actions/battery/icon",
      "Tooltip": "Display and cycle through an ordered list of battery devices",
      "PropertyInspectorPath": "ui/battery.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/battery/key",
          "TitleAlignment": "bottom",
          "FontSize": 10
        }
      ]
    }
  ]
}